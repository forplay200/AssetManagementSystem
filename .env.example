# Environment variables template
# Copy this file to .env and fill in the values

# Backend
PORT=3000
JWT_SECRET=your_jwt_secret_here
DATABASE_URL=postgres://user:password@localhost:5432/db
# Security compatibility switch. Keep false so public registration always creates Collaborators.

# Frontend (if using Create React App)
REACT_APP_API_URL=http://localhost:3000/api

# AI Service
AI_PORT=8000
AI_HOST=0.0.0.0
# Existing CLIP checkpoint; CPU is the default. GPU deployment also needs Docker GPU access.
CLIP_DEVICE=cpu
# Initial cosine similarity settings; calibrate these on representative assets.
CLIP_IMAGE_MIN_SIMILARITY=0.25
CLIP_MODEL_MIN_SIMILARITY=0.25
CLIP_MAX_SCORE_GAP=0.04

# Database (if using PostgreSQL via Docker)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Staged asset governance rollout. Keep disabled until full application deployment verification is complete.
ASSET_GOVERNANCE_ENABLED=false
# Permanent file cleanup requires a separate explicit switch; holds are still monitored when governance is enabled.
ASSET_PURGE_ENABLED=false
# Optional isolated integration test DB. Must be local and named governance_test; tests reset it.
# TEST_GOVERNANCE_DATABASE_URL=postgres://postgres:test_password@127.0.0.1:15439/governance_test

# Public community trial: anyone with the link can register, no manual approval.
# Enable with a random JWT_SECRET (32+ bytes) and explicit frontend origins.
PUBLIC_TRIAL_ENABLED=false
REGISTRATION_MODE=open
# Optional only: REGISTRATION_MODE=invite accepts a shared community code.
TRIAL_INVITE_CODE=
TRIAL_MAX_ACCOUNTS=300
TRIAL_WORKSPACES_PER_ACCOUNT=1
TRIAL_WORKSPACE_MIB=500
TRIAL_TOTAL_MIB=20480
TRIAL_AI_PER_DAY=20
TRIAL_AI_QUEUE_LIMIT=100
TRIAL_UPLOADS_PER_15_MIN=15
CORS_ORIGINS=http://localhost
TRUST_PROXY_HOPS=0
